    "import pandas as pd\n",
    "import os\n",
    "\n",
    "pfad = \"./Ordner/\"\n",
    "dfs = []\n",
    "\n",
    "for datei in os.listdir(pfad):\n",
    "    if datei.endswith(\".csv\"):\n",
    "        stadtname = datei.replace(\".csv\", \"\")\n",
    "        \n",
    "        \n",
    "        df = pd.read_csv(os.path.join(pfad, datei))\n",
    "        df.columns = [\"Jahr\", \"Mietpreis\"]  \n",
    "\n",
    "        \n",
    "        df[\"Mietpreis\"] = df[\"Mietpreis\"].str.replace(\"€\", \"\").str.replace(\",\", \".\").astype(float)\n",
    "        \n",
    "        df[\"Stadt\"] = stadtname  \n",
    "        dfs.append(df)\n",
    "\n",
    "\n",
    "gesamt_df = pd.concat(dfs, ignore_index=True)\n",
    "\n",
    "gesamt_df.to_csv(\"mieten_gesamt.csv\", index=False)\n"
   ]
